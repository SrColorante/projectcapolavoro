# =====================================================================
#  .env.example — configurazione di Quice
#
#  Copia questo file in `.env` e completalo:
#      cp .env.example .env
#
#  `.env` e' nel .gitignore: non tracciarlo mai, contiene i segreti.
#  In produzione, se APP_ENV=production, il server si rifiuta di avviarsi
#  se QUICE_APP_SECRET o QUICE_PRIVACY_PEPPER mancano.
# =====================================================================

# --- Ambiente -------------------------------------------------------
# development | production
# In "production" i dettagli degli errori non vengono piu' restituiti al
# client e i segreti obbligatori diventano obbligatori.
APP_ENV=development

# --- Segreti (OBBLIGATORI in produzione) ----------------------------
# Generali con: openssl rand -hex 32
# Non riutilizzare lo stesso valore per i due segreti.
QUICE_APP_SECRET=cambiami-con-openssl-rand-hex-32
QUICE_PRIVACY_PEPPER=cambiami-con-un-altro-rand-hex-32

# --- Database -------------------------------------------------------
# Percorso alternativo a host/name: utile per test e SQLite.
# QUICE_DB_DSN="mysql:host=127.0.0.1;dbname=chatProject;charset=utf8mb4"
QUICE_DB_HOST=127.0.0.1
QUICE_DB_NAME=chatProject
QUICE_DB_USER=quice
QUICE_DB_PASSWORD=

# --- CORS -----------------------------------------------------------
# Origini autorizzate, separate da virgola. `*` accettato SOLO in
# sviluppo. In produzione una lista vuota o `*` non e' accettabile:
# con il wildcard chiunque potrebbe leggere le risposte dell'API.
QUICE_ALLOWED_ORIGINS=http://localhost:3000

# --- Sessioni -------------------------------------------------------
# Durata del token di sessione, in secondi (default 30 giorni).
QUICE_SESSION_TTL_SECONDS=2592000

# Tentativi di accesso consentiti prima del blocco, e durata del blocco.
QUICE_MAX_LOGIN_ATTEMPTS=5
QUICE_LOGIN_LOCKOUT_SECONDS=900

# --- File -----------------------------------------------------------
# Limite massimo di un caricamento, in byte (default 50 MiB).
QUICE_MAX_UPLOAD_BYTES=52428800
# Se impostata, la cartella dei file puo' stare FUORI dal DocumentRoot:
# in quel caso servire_file.php e' l'unico modo per leggerli, il che e'
# la configurazione consigliata.
# QUICE_UPLOADS_DIR=/var/lib/quice/uploads

# --- Conservazione (Art. 5(1)(e)) ----------------------------------
# Giorni prima dell'eliminazione definitiva. Abbassarli riduce l'esposizione
# dei dati, ma le prove di consenso vanno conservate piu' a lungo perché
# servono a dimostrare la liceità del trattamento.
QUICE_RETENTION_MESSAGGI=365
QUICE_RETENTION_SHARED_FILES=180
QUICE_RETENTION_UTENTI_SESSIONI=30
QUICE_RETENTION_AUDIT_LOG=730
QUICE_RETENTION_CONSENS=1825

# Giorni di attesa tra la richiesta di cancellazione e la cancellazione
# definitiva, per dare modo all'utente di annullarla.
QUICE_ERASURE_GRACE_DAYS=30

# --- Log ------------------------------------------------------------
# Percorso del registro strutturato. Lasciare vuoto per scrivere solo su
# error_log. Il file dovrebbe stare su un volume con criteri di accesso
# appropriati.
# QUICE_AUDIT_LOG_PATH=/var/log/quice/audit.log

# --- WebSocket (opzionale) -----------------------------------------
QUICE_WS_BIND=127.0.0.1
QUICE_WS_PORT=8080
